# ==============================================================================
# Content Agent System — Environment Variables Configuration
# ==============================================================================

# Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# AI & LLM Provider API Keys
# ------------------------------------------------------------------------------
# Option 1: Polza AI / OpenAI-compatible endpoint for Claude Sonnet 3.5/4.5
POLZA_API_KEY=your_polza_api_key_here
AI_BASE_URL=https://api.polza.ai/api/v1
CLAUDE_MODEL=anthropic/claude-sonnet-4.5

# Option 2: Google Gemini (for Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 3: Direct OpenAI / Anthropic APIs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Project Paths (defaults to standard structure if omitted)
# MATERIALS_DIR=materials
# RAZBOR_DIR=analysis
# CONTENT_DIR=content
# KARUSEL_DIR=carousel_generator
